{
  "name": "metric-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "MetricMonitor — Smart GA4 Alerting & Monitoring SaaS",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
